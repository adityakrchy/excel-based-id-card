/* Light Theme Stylesheet for Excel ID Card Generator */

QMainWindow, QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
}

#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

#sidebar QPushButton {
    background-color: transparent;
    color: #475569;
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}

#sidebar QPushButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

#sidebar QPushButton:checked, #sidebar QPushButton[active="true"] {
    background-color: #EFF6FF;
    color: #2563EB;
    font-weight: 600;
}

#workflow_stepper {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 6px 16px;
}

#workflow_stepper QLabel {
    color: #94A3B8;
    font-weight: 500;
}

#workflow_stepper QLabel[active="true"] {
    color: #2563EB;
    font-weight: bold;
}

#workflow_stepper QLabel[completed="true"] {
    color: #059669;
}

QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton#btn_primary {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
    font-weight: 600;
}

QPushButton#btn_primary:hover {
    background-color: #1D4ED8;
}

QPushButton#btn_success {
    background-color: #059669;
    color: #FFFFFF;
    border: 1px solid #047857;
    font-weight: 600;
}

QPushButton#btn_success:hover {
    background-color: #047857;
}

QPushButton#btn_danger {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
    font-weight: 600;
}

QPushButton#btn_danger:hover {
    background-color: #B91C1C;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #2563EB;
}

QTableWidget, QTableView {
    background-color: #FFFFFF;
    color: #0F172A;
    gridline-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #1E3A8A;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-bottom: 1px solid #CBD5E1;
    font-weight: 600;
}

QGroupBox {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
    font-weight: bold;
    color: #475569;
}

QFrame#card_panel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 14px;
}

QStatusBar {
    background-color: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
    padding: 4px;
}

QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    text-align: center;
    color: #0F172A;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 5px;
}
